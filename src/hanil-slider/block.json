{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "hanil/tags",
  "title": "Hanil Tags",
  "category": "text",
  "icon": "images-alt2",
  "version": "0.1.0",
  "description": "Hanil Tags Block",
  "example": {},
  "supports": {
    "color": {
      "background": false,
      "text": true
    },
    "align": true,
    "html": false,
    "typography": {
      "fontSize": true
    }
  },
  "attributes": {
    "images": {
      "type": "array",
      "default": []
    },
    "selectedTags": {
      "type": "string",
      "default": []
    }
  },
  "textdomain": "edumall-child",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css"
}
